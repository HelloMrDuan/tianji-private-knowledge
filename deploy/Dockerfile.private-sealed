# Private runner only: the build context MUST be a verified sealed bundle.
# This image embeds confidential reviewed runtime data; NEVER publish to a
# public registry, web root, or publicly accessible Actions artifact.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \\
    PYTHONUNBUFFERED=1 \\
    PYTHONPATH=/opt/tianji/src \\
    TIANJI_RUNTIME_MODE=sealed \\
    TIANJI_RUNTIME_ROOT=/opt/tianji

RUN python -m pip install --no-cache-dir \\
    "fastapi>=0.115,<1" "pydantic>=2.9,<3" "uvicorn>=0.30,<1" \\
    "lunar-python==1.4.8" "jsonschema>=4.18,<5" "httpx>=0.27,<1"

WORKDIR /opt/tianji
ARG RUNTIME_SHA256
ENV TIANJI_RUNTIME_SHA256=${RUNTIME_SHA256}
COPY --chown=10001:10001 build/ ./build/
COPY --chown=10001:10001 data/ ./data/
COPY --chown=10001:10001 src/ ./src/

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "tianji_kb.api:app", "--host", "0.0.0.0", "--port", "8000"]
