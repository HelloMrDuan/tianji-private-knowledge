      }
    },
    {
      "number": 24,
      "full_name": "地雷复",
      "judgment": "復。 亨。出入無疾，朋來無咎。反覆其道，七日來復，利有攸往。",
      "image": "雷在地中，復。先王以至日閉關，商旅不行，後不省方。",
      "lines": [
        {
          "position": "初九",
          "text": "不遠復，無祇悔，元吉。"
        },
        {
          "position": "六二",
          "text": "休復，吉。"
        },
        {
          "position": "六三",
          "text": "頻復，厲，無咎。"
        },
        {
          "position": "六四",
          "text": "中行獨復。"
        },
        {
          "position": "六五",
          "text": "敦復，無悔。"
        },
        {
          "position": "上六",
          "text": "迷復，凶，有災眚。用行師，終有大敗，以其國君凶，至於十年不克征。"
        }
      ],
      "provenance": {
        "repo": "sunls2/zhouyi",
